# ORIGINX environment — copy to .env for local development.
# Production values: see .env.production.example and docs/DEPLOYMENT.md.

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
# Web app origin (Vite dev server locally). QR codes point at APP_URL/verify unless PUBLIC_VERIFY_BASE_URL is set.
PUBLIC_VERIFY_BASE_URL=
# Comma-separated allowed browser origins ("*" only for local development).
CORS_ORIGINS=*

# --- Database (PostgreSQL) -----------------------------------------------------
# Local: `npm run db:up` starts Postgres 17 in Docker on port 5434.
DATABASE_URL=postgresql://originx:originx_local_dev@127.0.0.1:5434/originx?schema=public
DIRECT_URL=postgresql://originx:originx_local_dev@127.0.0.1:5434/originx?schema=public

# --- Security ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
PRIVACY_HASH_SALT=
TRUST_PROXY=loopback
BEHIND_CLOUDFLARE=false
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=30
VERIFY_RATE_LIMIT=30
UNKNOWN_TOKEN_LIMIT=20
CLONE_SCAN_THRESHOLD=25

# --- Product behaviour -----------------------------------------------------------
# DEMO_MODE enables the demo tamper endpoint and returns email/reset tokens in API responses
# (no email provider yet). It MUST be false in production (the server refuses to start otherwise).
DEMO_MODE=true
ENFORCE_ENTITLEMENTS=false

# --- Blockchain ------------------------------------------------------------------
# evm      : anchor proofs on an EVM chain via contracts/OriginXProofAnchor.sol
# disabled : proofs are recorded as PENDING (no transaction hash) until a chain is configured
BLOCKCHAIN_MODE=evm
# Local: leave RPC/contract empty and run `npm run chain` + `npm run chain:deploy`
# (the deployment is saved to .originx-chain.json and picked up automatically).
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_CHAIN_ID=
BLOCKCHAIN_NETWORK=
# Required for any non-local chain. Use a dedicated anchoring wallet; never commit it.
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_EXPLORER_TX_URL=
BLOCKCHAIN_ANCHOR_POLICY=all
BLOCKCHAIN_RETRY_INTERVAL_MS=30000

# --- ASK ORIGINX (optional) ------------------------------------------------------
# Without a key, answers are deterministic and fact-only.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=claude-opus-5-5
