# ORIGINX production environment (Hostinger VPS + Supabase + Cloudflare).
# Copy to .env.production ON THE SERVER ONLY (chmod 600). Never commit real values.

NODE_ENV=production
APP_URL=https://originx.your-domain.com
# QR codes open APP_URL/verify by default (web app and API share one domain; nginx proxies /api).
PUBLIC_VERIFY_BASE_URL=
CORS_ORIGINS=https://originx.your-domain.com

# --- Supabase (Project Settings → Database → Connection string) ---------------
# Runtime: Transaction pooler (port 6543). Keep pgbouncer=true; small pool per instance.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require
# Migrations: Session pooler / direct connection (port 5432).
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Security (generate each with: openssl rand -base64 48) -----------------------
JWT_ACCESS_SECRET=
PRIVACY_HASH_SALT=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
DEMO_MODE=false
ENFORCE_ENTITLEMENTS=true
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=30
VERIFY_RATE_LIMIT=30
UNKNOWN_TOKEN_LIMIT=20
CLONE_SCAN_THRESHOLD=25

# --- Email (SMTP) — password resets, email verification, invitations -----------------
# Any SMTP provider: Hostinger Mail (smtp.hostinger.com:465), Resend (smtp.resend.com:465),
# Brevo (smtp-relay.brevo.com:587), Amazon SES, … MAIL_FROM must be a sender your provider allows
# (verify the domain with SPF/DKIM in Cloudflare DNS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ORIGINX <no-reply@your-domain.com>
# Optional: inbox notified about new organizations awaiting approval and contact messages.
MAIL_ADMIN_NOTIFY=

# --- Blockchain OPTION A: self-hosted private chain (no faucet, no money) -------------------
# Add COMPOSE_PROFILES=private-chain to the project .env, then use:
#   BLOCKCHAIN_PRIVATE_CHAIN=true  BLOCKCHAIN_NETWORK=originx-private  BLOCKCHAIN_CHAIN_ID=31337
#   BLOCKCHAIN_RPC_URL=http://chain:8545  BLOCKCHAIN_CONFIRMATIONS=1  BLOCKCHAIN_EXPLORER_TX_URL=
# Real smart-contract proofs, persisted in a Docker volume, but not publicly verifiable.
#
# --- Blockchain OPTION B (live setup): Ethereum Hoodi public testnet ----------------------------
# Free test ETH from the PoW faucet (https://hoodi-faucet.pk910.de) — works for brand-new wallets.
# (Sepolia's PoW faucet cannot fund new wallets: first transfers need ~207k gas there.)
# Polygon Amoy also works: polygon-amoy / 80002 / https://polygon-amoy.drpc.org / https://amoy.polygonscan.com/tx
BLOCKCHAIN_MODE=evm
BLOCKCHAIN_NETWORK=ethereum-hoodi
BLOCKCHAIN_CHAIN_ID=560048
BLOCKCHAIN_RPC_URL=https://ethereum-hoodi-rpc.publicnode.com
BLOCKCHAIN_CONTRACT_ADDRESS=
# Dedicated anchoring wallet (0x-prefixed, test funds only). Never a wallet holding real money.
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS=2
BLOCKCHAIN_TX_TIMEOUT_MS=180000
BLOCKCHAIN_EXPLORER_TX_URL=https://hoodi.etherscan.io/tx
BLOCKCHAIN_ANCHOR_POLICY=critical
BLOCKCHAIN_RETRY_INTERVAL_MS=30000

# --- AI (optional): "Ask ORIGINX" on product pages ------------------------------------------
# Without a key it falls back to deterministic answers. (The website chatbot is a local rule
# engine and needs no key.)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# Website chatbot questions per visitor per 10 minutes.
CHAT_RATE_LIMIT=20

# --- Cloudflare Turnstile ("Verify you are human") on sign-in, sign-up, password reset, contact ---
# Cloudflare dashboard → Turnstile → Add widget (hostname = your domain, mode Managed). Both or none.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google Sign-In (OAuth client ID is public; must match the web app) -------------------------
GOOGLE_CLIENT_ID=
