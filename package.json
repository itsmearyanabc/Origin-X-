{
  "name": "originx",
  "version": "1.0.0",
  "description": "ORIGINX — The Verifiable Identity Layer for Physical Products",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "tsx scripts/assert-local-db.ts && prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "chain": "hardhat node",
    "chain:deploy": "tsx scripts/deploy-contract.ts",
    "contract:compile": "tsx scripts/compile-contract.ts",
    "anchor:pending": "node dist/cli/anchor-pending.js",
    "demo": "tsx scripts/demo.ts",
    "postinstall": "prisma generate",
    "admin:create": "node dist/cli/create-admin.js",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:inventory": "tsx prisma/seed-inventory.ts",
    "db:seed:sales-demo": "tsx prisma/seed-sales-demo.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@metamask/logo": "^4.0.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.16",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.6.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "hardhat": "^2.26.3",
    "solc": "^0.8.30",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
